
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body {
    background: #f4f6fb;
    color: #263238;
    padding: 30px;
}

h1 {
    color: #263b80;
    margin-bottom: 20px;
}

h2 {
    margin-bottom: 15px;
    color: #263b80;
}

h3 {
    margin-bottom: 10px;
}

p {
    margin: 12px 0;
}

/* Dashboard Cards */

.dashboard-container {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    margin: 25px 0;
}

.dashboard-card {
    background: white;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.07);
    min-width: 220px;
    margin: 15px 0;
}

.dashboard-card h1 {
    font-size: 35px;
    color: #5268d8;
    margin-top: 15px;
}

/* Charts */

.chart-card {
    background: white;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.07);
    max-width: 850px;
    margin: 20px 0;
}

/* Tables */

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

th {
    background: #5268d8;
    color: white;
    padding: 15px;
    text-align: left;
}

td {
    padding: 13px;
    border-bottom: 1px solid #eeeeee;
}

tr:hover {
    background: #f5f7ff;
}

/* Inputs */

input {
    padding: 12px;
    border: 1px solid #d5dbea;
    border-radius: 7px;
    margin: 7px 0;
    outline: none;
}

input:focus {
    border-color: #5268d8;
}

/* Buttons */

button {
    background: #5268d8;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 7px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #3549b0;
}

/* Links */

a {
    color: #5268d8;
    text-decoration: none;
    margin-right: 10px;
}

a:hover {
    text-decoration: underline;
}

/* Forms */

form {
    margin: 20px 0;
}

/* Mobile Responsive */

@media (max-width: 768px) {
    body {
        padding: 15px;
    }

    .dashboard-container {
        flex-direction: column;
    }

    .dashboard-card {
        width: 100%;
    }

    table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }
}
